rules_version = '2';

// PopSpell — who can read and write what.
//
//  • The owner (listed below) grants site admin access.
//  • Site admins can manage every class and invite teachers.
//  • Invited teachers sign in with Google and see only their own classes.
//  • Pupils' devices sign in anonymously. Knowing a class code lets a device add results,
//    live progress and help requests to that class, and look up its own assigned lists.
//    Pupils can never read other pupils' results or the class list.
//  • A parent link opens one pupil's progress summary, which the teacher writes. Nothing else.
//
// Paste this whole file into Firebase console → Firestore Database → Rules, and publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // ⬇ The owner's Google email address (lower case). Add more inside the brackets if needed.
    function owners() { return ['owner@example.com']; }

    function signedIn() { return request.auth != null; }
    function google() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email.lower(); }
    function teacherDoc() { return /databases/$(database)/documents/teachers/$(email()); }
    function isOwner() { return google() && email() in owners(); }
    function isAdmin() {
      return google() && (isOwner()
        || (exists(teacherDoc()) && get(teacherDoc()).data.role == 'admin'));
    }
    function isTeacher() { return google() && (isAdmin() || exists(teacherDoc())); }
    function classDoc(c) { return get(/databases/$(database)/documents/classes/$(c)); }
    function teaches(c) { return isTeacher() && classDoc(c).data.teacher == request.auth.uid; }
    function canSee(c) { return isAdmin() || teaches(c); }
    function shortText(v, n) { return v is string && v.size() <= n; }

    // Invited teachers, keyed by their Google email in lower case
    match /teachers/{em} {
      allow get: if isAdmin() || (google() && email() == em);
      allow list: if isAdmin();
      // Only the owner may grant site admin access. Admins may invite teachers.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'role', 'invitedBy', 'invitedAt'])
        && (request.resource.data.role == 'teacher'
          || (isOwner() && request.resource.data.role == 'admin')
          || (isOwner() && em == email() && request.resource.data.role == 'owner'));
      allow update: if isAdmin()
        && resource.data.role != 'owner'
        && (resource.data.role != 'admin' || isOwner())
        && (request.resource.data.role == 'teacher'
          || (isOwner() && request.resource.data.role == 'admin'));
      allow delete: if isAdmin() && em != email()
        && resource.data.role != 'owner'
        && (resource.data.role != 'admin' || isOwner());
    }

    // A class; its id is the join code pupils type
    match /classes/{c} {
      allow get: if signedIn();
      allow list: if isAdmin() || (isTeacher() && resource.data.teacher == request.auth.uid);
      allow create: if isTeacher()
        && request.resource.data.teacher == request.auth.uid
        && shortText(request.resource.data.name, 60)
        && request.resource.data.keys().hasOnly(['name', 'teacher', 'teacherName', 'teacherEmail', 'createdAt']);
      allow update: if canSee(c)
        && request.resource.data.teacher == resource.data.teacher
        && shortText(request.resource.data.name, 60)
        && (!('assignedOnly' in request.resource.data) || request.resource.data.assignedOnly is bool)
        && (!('accent' in request.resource.data) || request.resource.data.accent in ['scottish', 'english']);
      allow delete: if canSee(c);

      // Where each pupil is up to right now (one document per pupil)
      match /live/{p} {
        allow read, delete: if canSee(c);
        allow create, update: if canSee(c) || (signedIn() && exists(/databases/$(database)/documents/classes/$(c))
          && request.resource.data.keys().hasOnly(['pupil', 'list', 'status', 'done', 'total', 'right',
               'missedRow', 'notFirstRow', 'lastWord', 'help', 'helpAt', 'seen'])
          && shortText(request.resource.data.pupil, 40));
      }

      // One document per finished (or stopped) list
      match /sessions/{s} {
        allow read, delete: if canSee(c);
        allow create: if signedIn() && exists(/databases/$(database)/documents/classes/$(c))
          && shortText(request.resource.data.pupil, 40)
          && request.resource.data.words is list && request.resource.data.words.size() <= 60
          && (request.resource.data.keys().hasOnly(['pupil', 'list', 'listId', 'finished', 'words', 'at'])
            || (canSee(c) && request.resource.data.keys().hasOnly([
                'pupil', 'list', 'listId', 'finished', 'words', 'at', 'source', 'markedBy'])
              && request.resource.data.source in ['worksheet', 'phonics-check']
              && request.resource.data.markedBy == email()));
      }

      // Phonics check practice, marked live: the teacher's screen sets the word on show, and the
      // pupil's device (which only knows its own key, as with assign) reads it. Nothing else is in it.
      match /drive/{p} {
        allow get: if signedIn();
        allow delete: if canSee(c);
        allow create, update: if canSee(c)
          && request.resource.data.keys().hasOnly(['kind', 'word', 'n', 'total', 'alien', 'section', 'at'])
          && request.resource.data.kind == 'phonics'
          && shortText(request.resource.data.word, 30)
          && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 40
          && request.resource.data.total is int && request.resource.data.total <= 40
          && request.resource.data.alien is bool
          && request.resource.data.section in [1, 2];
      }

      // Lists set for each pupil, keyed by a fingerprint of their name (or "everyone").
      // A pupil's device can only fetch the one it knows the key for.
      match /assign/{a} {
        allow get: if signedIn();
        allow list, write: if canSee(c);
      }

      // Each pupil's own progress (sound stars, review words, personal bests), so it follows them
      // from a school tablet to a home device. Keyed by a fingerprint of their name, like assign.
      match /progress/{p} {
        allow get: if signedIn();
        allow list, delete: if canSee(c);
        allow create, update: if signedIn() && exists(/databases/$(database)/documents/classes/$(c))
          && request.resource.data.keys().hasOnly(['pupil', 'words', 'sounds', 'bests', 'updated'])
          && shortText(request.resource.data.pupil, 40)
          && request.resource.data.words is map
          && request.resource.data.sounds is map
          && request.resource.data.bests is map;
      }

      // Lesson notes are private to the class teacher and site admins.
      match /diary/{entry} {
        allow read, delete: if canSee(c);
        allow create: if canSee(c)
          && request.resource.data.keys().hasOnly([
            'pupil', 'lessonDate', 'lastWork', 'nextLesson', 'nextList', 'nextDate', 'by', 'at'])
          && shortText(request.resource.data.pupil, 40)
          && shortText(request.resource.data.lessonDate, 10)
          && shortText(request.resource.data.lastWork, 2000)
          && shortText(request.resource.data.nextLesson, 2000)
          && shortText(request.resource.data.nextList, 100)
          && shortText(request.resource.data.nextDate, 10)
          && request.resource.data.by == email();
      }

      // Pupil roster and parent contact details are never readable by pupil devices.
      match /pupils/{p} {
        allow read, delete: if canSee(c);
        function validPupil() {
          return canSee(c)
          && request.resource.data.keys().hasOnly([
            'name', 'parentEmail', 'reminderOptIn', 'nextLessonDate',
            'lessonTime', 'homeworkList', 'updated', 'parentLink', 'parentAt', 'parentNote',
            'yearGroup', 'needs', 'likes', 'reports', 'programme'])
          && shortText(request.resource.data.name, 40)
          && shortText(request.resource.data.parentEmail, 254)
          && request.resource.data.reminderOptIn is bool
          && shortText(request.resource.data.nextLessonDate, 10)
          && shortText(request.resource.data.lessonTime, 5)
          && shortText(request.resource.data.homeworkList, 100)
          && (!('parentLink' in request.resource.data) || shortText(request.resource.data.parentLink, 64))
          && (!('parentAt' in request.resource.data) || request.resource.data.parentAt is number)
          && (!('parentNote' in request.resource.data) || shortText(request.resource.data.parentNote, 1000))
          && (!('yearGroup' in request.resource.data) || shortText(request.resource.data.yearGroup, 10))
          && (!('needs' in request.resource.data) || shortText(request.resource.data.needs, 500))
          && (!('likes' in request.resource.data) || shortText(request.resource.data.likes, 300))
          && (!('reports' in request.resource.data) || (request.resource.data.reports is list && request.resource.data.reports.size() <= 12))
          && (!('programme' in request.resource.data) || request.resource.data.programme == null || validProgramme(request.resource.data.programme));
        }
        // The pupil's place in their lesson programme, and the last few lessons
        function validProgramme(p) {
          return p is map && p.keys().hasOnly(['spelling', 'maths', 'focus', 'lesson', 'started', 'log'])
          && shortText(p.get('spelling', ''), 60) && shortText(p.get('maths', ''), 60)
          && p.get('focus', 'both') in ['both', 'literacy', 'maths']
          && p.get('lesson', 1) is int && p.get('lesson', 1) >= 1 && p.get('lesson', 1) <= 1000
          && p.get('started', 0) is number
          && (!('log' in p) || (p.log is list && p.log.size() <= 30));
        }
        allow create: if validPupil();
        allow update: if validPupil()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']);
      }
    }

    // Parent pages: one progress summary per pupil, kept under a long random link. Anyone with
    // the link can open that one summary, but nobody can list them. Only the class's teacher or
    // a site admin can write one, and a summary can't be moved to another class.
    match /parents/{t} {
      allow get: if t.size() >= 24;
      function validParent() {
        return t.size() >= 24 && canSee(request.resource.data.classId)
          && request.resource.data.keys().hasOnly(['classId', 'pupil', 'summary', 'note', 'updated', 'by'])
          && shortText(request.resource.data.pupil, 40)
          && shortText(request.resource.data.note, 1000)
          && request.resource.data.summary is map
          && request.resource.data.by == email();
      }
      allow create: if validParent();
      allow update: if validParent() && request.resource.data.classId == resource.data.classId;
      allow delete: if canSee(resource.data.classId);
    }
  }
}

